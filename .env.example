# 🌿 Configurações do Supabase para o VitaFin
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase

# URL do seu projeto Supabase (encontrada em Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon (encontrada em Project Settings -> API -> Project API keys -> anon / public)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
